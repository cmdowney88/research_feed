<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Weekly literature run, Wednesdays 11:00 local time. Installed by scripts/install_weekly.sh,
     which replaces __REPO__ and __DATA__ with the code checkout and the data directory. If the
     Mac is asleep at 11:00, launchd runs the job once on wake. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.litfeed.weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__REPO__/scripts/weekly.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LITFEED_DATA</key>
    <string>__DATA__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>3</integer>
    <key>Hour</key>
    <integer>11</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__DATA__/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__DATA__/logs/launchd.log</string>
</dict>
</plist>
